<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F8"
    tools:context=".ui.theme.addCow">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <!-- Header: terugknop en titel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/goBack"
                    android:textColor="#176B78"
                    android:textSize="22sp"
                    android:backgroundTint="#E0F2F1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="20dp">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Koe 11"
                        android:textColor="#176B78"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alle gegevens van koe 11"
                        android:textColor="#78909C"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Kaart: Koegegevens -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:elevation="3dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="48dp">

                    <TextView
                        android:id="@+id/textCowNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Koe 11"
                        android:textColor="#263238"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textEarTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Oormerk: 1007"
                        android:textColor="#78909C"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Bewerken rechtsboven -->
                <TextView
                    android:id="@+id/buttonEditCow"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:clickable="true"
                    android:contentDescription="Koe bewerken"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="✎"
                    android:textColor="#176B78"
                    android:textSize="28sp" />

            </FrameLayout>

            <!-- Kaart: Algemene gegevens -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_input"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Algemene gegevens"
                    android:textColor="#176B78"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textCowGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:text="Geslacht: Vrouwelijk"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textCowColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:text="Kleur: Bruin"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textCowBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:text="Geboortedatum: 01-01-2024"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Knop: Behandeling toevoegen -->
            <Button
                android:id="@+id/button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#009688"
                android:text="Behandeling toevoegen"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Knop: Koe verwijderen -->
            <Button
                android:id="@+id/button1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#009688"
                android:text="Koe verwijderen"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
