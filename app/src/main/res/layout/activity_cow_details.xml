<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F8"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Koe 11"
            android:textColor="#176B78"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="alle gegevens van koe 11"
            android:textColor="#78909C"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:elevation="3dp"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:id="@+id/textCowNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="koe 11"
                        android:textColor="#263238"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textEarTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Oormerk: 1007"
                        android:textColor="#78909C"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/buttonEditCow"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="✎"
                    android:textColor="#78909C"
                    android:textSize="28sp"
                    android:contentDescription="Koe bewerken"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>



            <!-- Kaart: Algemene gegevens -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:background="@drawable/bg_input"
                android:elevation="3dp"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Algemene gegevens"
                    android:textColor="#176B78"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/textCowGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:text="Geslacht: Vrouwelijk"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textCowColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:text="Kleur: Bruin"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textCowBirthDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:text="Geboortedatum: 01-01-2024"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

            </LinearLayout>


        <Button
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#009688"
            android:text="behandeling toevoegen"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/button1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#009688"
            android:text="koe verwijderen"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
