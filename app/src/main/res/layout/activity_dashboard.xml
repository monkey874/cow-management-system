<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F8">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <!-- Welkom -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cow Management"
                android:textColor="#176B78"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welkom terug! Wat wil je vandaag doen?"
                android:textColor="#78909C"
                android:textSize="15sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp" />

            <!-- Overzicht -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Overzicht"
                android:textColor="#176B78"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Rij 1: Koeienlijst en Meldingenlijst -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/cowButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐄"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Koeienlijst"
                        android:textColor="#78909C"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/textCowCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bekijk koeien"
                        android:textColor="#176B78"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/noticionButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔔"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meldingenlijst"
                        android:textColor="#78909C"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/textNotificationCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bekijk meldingen"
                        android:textColor="#176B78"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Rij 2: Gebruikerslijst en Geschiedenis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:id="@+id/userButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gebruikerslijst"
                        android:textColor="#78909C"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/textUserCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bekijk gebruikers"
                        android:textColor="#176B78"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/historyButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_input"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋"
                        android:textSize="25sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Geschiedenis"
                        android:textColor="#78909C"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/textHistoryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bekijk geschiedenis"
                        android:textColor="#176B78"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Beheer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Beheer"
                android:textColor="#176B78"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Koe toevoegen -->
            <Button
                android:id="@+id/btnAddCow"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="+  Koe toevoegen"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#009688"
                android:layout_marginBottom="12dp" />

            <!-- Melding toevoegen -->
            <Button
                android:id="@+id/btnNotifications"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="+  Melding toevoegen"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#009688"
                android:layout_marginBottom="12dp" />

            <!-- Gebruiker toevoegen -->
            <Button
                android:id="@+id/btnAddUser"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="+  Gebruiker toevoegen"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#009688"
                android:layout_marginBottom="12dp" />

            <!-- Behandeling toevoegen -->
            <Button
                android:id="@+id/btnAddTreatment"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="+  Behandeling toevoegen"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#009688"
                android:layout_marginBottom="24dp" />

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cow Management System"
                android:textColor="#78909C"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
